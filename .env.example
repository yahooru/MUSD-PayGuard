# MUSD PayGuard environment (copy to .env.local; never commit real values)

# Postgres (Neon). All tables live in the `payguard` schema.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 48+ random bytes, base64url. Signs the HttpOnly session JWT (HS256).
SESSION_SECRET=replace-with-long-random-string

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=replace-with-long-random-string

# Optional overrides
# NEXT_PUBLIC_SITE_URL=https://musd-payguard.vercel.app
# MEZO_RPC_URL=https://rpc.test.mezo.org

# Only for scripts/e2e-testnet.ts (read at runtime, never copied into the project)
# TEST_WALLETS_FILE=C:\path\to\test-wallets.json
# E2E_BASE_URL=http://localhost:3000

# Only for contracts/scripts/deploy.ts. Default: contracts/.env.deployer (git-ignored),
# containing one line PRIVATE_KEY=0x...
# DEPLOYER_ENV_FILE=C:\path\outside\the\repo\deployer.env
